<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background Circle (Blue/Green Gradient base) -->
    <path
        android:pathData="M54,54m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40"
                android:type="radial">
                <item android:color="#006400" android:offset="0.0"/> <!-- Green -->
                <item android:color="#1A56BE" android:offset="1.0"/> <!-- Noble Blue -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cards (Representing the 3 white sheets in logo) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,38h24v30h-24z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,42h24v30h-24z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,46h24v30h-24z" />

    <!-- Swoosh (Golden/Yellow element) -->
    <path
        android:pathData="M30,65 Q54,50 78,75"
        android:strokeWidth="4"
        android:strokeColor="#FFD700" />

    <!-- Bottom Swoosh (Blue element) -->
    <path
        android:pathData="M30,75 Q54,60 78,85"
        android:strokeWidth="6"
        android:strokeColor="#1E90FF" />

</vector>